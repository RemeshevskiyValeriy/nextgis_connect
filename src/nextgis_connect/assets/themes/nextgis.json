  "typography": {
    "displayFamily": [
      "Inter Display",
      "Inter",
      "Segoe UI",
      "Roboto",
      "sans-serif"
    ],
    "headingFamily": [
      "Inter",
      "Segoe UI",
      "Roboto",
      "sans-serif"
    ],
    "bodyFamily": [
      "Inter",
      "Roboto",
      "Segoe UI",
      "Arial",
      "sans-serif"
    ],
    "legacyFamily": [
      "Ubuntu",
      "Roboto",
      "sans-serif"
    ],
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "desktop": {
      "display": {
        "sizePx": 48,
        "lineHeight": 1.12,
        "weight": 700
      },
      "h1": {
        "sizePx": 34,
        "lineHeight": 1.18,
        "weight": 700
      },
      "h2": {
        "sizePx": 24,
        "lineHeight": 1.25,
        "weight": 700
      },
      "h3": {
        "sizePx": 18,
        "lineHeight": 1.35,
        "weight": 600
      },
      "bodyLarge": {
        "sizePx": 18,
        "lineHeight": 1.55,
        "weight": 400
      },
      "body": {
        "sizePx": 16,
        "lineHeight": 1.5,
        "weight": 400
      },
      "control": {
        "sizePx": 14,
        "lineHeight": 1.4,
        "weight": 500
      },
      "caption": {
        "sizePx": 12,
        "lineHeight": 1.4,
        "weight": 400
      }
    }
  },
  "spacingPx": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radiusPx": {
    "field": 8,
    "button": 4,
    "card": 8,
    "panel": 18,
    "pill": 999
  },
  "sizePx": {
    "iconSmall": 16,
    "icon": 20,
    "iconLarge": 24,
    "controlCompact": 32,
    "control": 40,
    "controlLarge": 48,
    "containerMax": 1200
  },
  "motion": {
    "fastMs": 120,
    "standardMs": 180,
    "slowMs": 240,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "allowed": [
      "color",
      "background-color",
      "border-color",
      "opacity",
      "focus-ring",
      "chevron-rotation",
      "dropdown-fade"
    ],
    "disallowed": [
      "button-translate",
      "card-lift",
      "hover-scale"
    ]
  }
